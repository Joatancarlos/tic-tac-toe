generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  password     String
  tokenVersion Int        @default(0)
  status       UserStatus @default(OFFLINE)

  Score           Score[]
  User_Match      User_Match[]
  invitesReceived MatchInvite[] @relation("InvitedUser")
  invitesSent     MatchInvite[] @relation("InviterUser")
}

enum UserStatus {
  ONLINE
  IN_MATCH
  OFFLINE
}

model Match {
  id     String     @id @default(uuid())
  status GameStatus @default(WAITING)

  currentPlayerId String?
  User_Match      User_Match[]
  MatchInvite     MatchInvite[]
}

model User_Match {
  id      String @id @default(uuid())
  userId  String
  matchId String

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
}

model Score {
  id        String @id @default(uuid())
  userId    String
  victories Int    @default(0)
  draw      Int    @default(0)

  user User @relation(fields: [userId], references: [id])
}

enum GameStatus {
  WAITING
  ON_GOING
  FINISHED
}

model HttpLog {
  id           Int      @id @default(autoincrement())
  method       String
  url          String
  status       Int
  responseTime Int?
  ip           String?
  userAgent    String?
  error        String?
  createdAt    DateTime @default(now())

  @@index([method])
  @@index([status])
  @@index([createdAt])
}

model MatchInvite {
  id        String            @id @default(uuid())
  matchId   String
  invitedId String
  invitedBy String
  status    MatchInviteStatus @default(PENDING)

  match   Match @relation(fields: [matchId], references: [id])
  invited User  @relation("InvitedUser", fields: [invitedId], references: [id])
  inviter User  @relation("InviterUser", fields: [invitedBy], references: [id])

  @@unique([matchId, invitedId])
}

enum MatchInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}
